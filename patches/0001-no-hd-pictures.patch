 // Widescreen lines drawn at the console's scale, as hires pairs, and whether each has hires pixels.
+#ifdef ARMSNES_HOST_NO_HD
+static u16 wideRows[2][1];
+#else
 static u16 wideRows[2][OUTPUT_HEIGHT * WIDE_COLUMNS * 2];
+#endif
